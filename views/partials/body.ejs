<!-- body partial for table of events -->
<table class="content-table">
    <thead>
        <tr>
            <th>Event</th>
            <th>Description</th>
            <th>Date</th>
        </tr>
    </thead>
    <tbody>
        <% events.forEach(function(event) { %>
            <tr class="active-row">
            <td><%= event.name %></td>
            <td><%= event.description %></td>
            <td><%= event.date %></td>
            </tr>
        <% }); %>
    </tbody>
</table>